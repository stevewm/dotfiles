" Indent two spaces for YAML
autocmd FileType yaml setlocal ts=2 sts=2 sw=2 expandtab

" Automatically reload files when they are changed outside of Vim
set autoread

" Highlight search results
set hlsearch
" Incremental search
set incsearch
" Ignore case in search patterns
set ignorecase
" Override ignorecase if the search pattern contains uppercase letters
set smartcase

" Show matching parentheses
set showmatch

" Silence the bell and visual bell
set noerrorbells
set novisualbell
set t_vb=

" Syntax highlighting
syntax on

" Enable line numbers
set number

" Use spaces instead of tabs
set expandtab
set shiftwidth=4

" Always show the status line
set laststatus=2

" Cursor line highlighting
set cursorline
set cursorcolumn
